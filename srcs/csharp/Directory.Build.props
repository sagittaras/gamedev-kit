<Project>

    <!-- A project is a released package exactly when it has its own version.json. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/version.json')">
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
    </ItemGroup>

    <!-- The Unity package pre-image commits its PDB: deterministic source paths keep the local disk layout out of it. -->
    <PropertyGroup Condition="'$(UpdateUnityPackage)' == 'true' Or '$(UpdateUnityPackage)' == 'force'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
