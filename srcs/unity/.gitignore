# Unity-generated state — rebuilt by the editor on open.
/[Ll]ibrary/
/[Tt]emp/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE project files regenerated by Unity from the asmdefs.
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs

# Unity crash and build leftovers.
sysinfo.txt
crashlytics-build.properties
*.unitypackage
*.apk
*.aab

# Unlike the stock Unity template, *.pdb and *.pdb.meta are deliberately NOT ignored — the package
# pre-images in Packages/*/Plugins/ ship the PDB next to the DLL and are committed as a whole.
